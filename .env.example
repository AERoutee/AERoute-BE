NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://aeroute.my.id
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aeroute
GOOGLE_MAPS_SERVER_KEY=replace-with-server-key-restricted-to-routes-and-air-quality
PROVIDER_TIMEOUT_MS=8000
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace-with-smtp-password
S3_ENDPOINT=https://storage.example.com
S3_REGION=auto
S3_BUCKET=replace-with-private-bucket
S3_PUBLIC_BASE_URL=https://your-bucket.t3.tigrisfiles.io
S3_ACCESS_KEY_ID=replace-with-rotated-access-key
S3_SECRET_ACCESS_KEY=replace-with-rotated-secret-key
TRUST_PROXY=false
